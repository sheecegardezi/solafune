server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # proxy API + tiles + health to the backend (compose: server; remote: BACKEND_URL env)
  # proxy_ssl_server_name: send SNI when BACKEND_URL is https
  location /api/    { proxy_pass ${BACKEND_URL}; proxy_ssl_server_name on; }
  location /tiles/  { proxy_pass ${BACKEND_URL}; proxy_ssl_server_name on; }

  # SPA fallback
  location / {
    try_files $uri /index.html;
  }

  # hashed vite assets are immutable — cache aggressively
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
}
